# LunarSync — copy to .env and fill in locally. Never commit .env.
# See docs/PROJECT_STRUCTURE.md and docs/TECH_STACK.md.

# --- Backend (FastAPI) ---
DATABASE_URL=postgresql+psycopg://lunarsync:lunarsync@localhost:5432/lunarsync
REDIS_URL=redis://localhost:6379/0

# --- Object storage (MinIO, S3-compatible) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=lunarsync
MINIO_SECURE=false

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- ML ---
# cuda | cpu (worker auto-falls back to CPU classical pipeline if no GPU)
MODEL_DEVICE=cpu

# --- Hugging Face dynamic archive (replaces static data/reference/) ---
# Token with read access to HF_DATASET. Never commit .env.
HF_TOKEN=
HF_DATASET=lunar-team-2026/data-image
# Optional: cap sweep size (0 = all 626) and early-stop score
HF_SWEEP_LIMIT=0
HF_EARLY_STOP=60.0

# --- Storage paths (local dev) ---
DATA_DIR=./data
MODELS_DIR=./backend/models
