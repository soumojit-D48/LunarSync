# LunarSync — copy to .env and fill in locally. Never commit .env.
# See docs/PROJECT_STRUCTURE.md and docs/TECH_STACK.md.

# --- Backend (FastAPI) ---
REDIS_URL=redis://localhost:6379/0

# --- Object storage (MinIO, S3-compatible) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=lunarsync
MINIO_SECURE=false

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
# Production frontend origin(s) allowed by backend CORS (comma-separated).
FRONTEND_URL=https://lunar-syncc.vercel.app

# --- ML ---
# cuda | cpu (worker auto-falls back to CPU classical pipeline if no GPU)
MODEL_DEVICE=cpu

# --- Reference backend toggle: hf | cloud (default hf, HF path untouched) ---
REFERENCE_BACKEND=hf

# --- Cloud mode (only needed when REFERENCE_BACKEND=cloud) ---
# Neon Postgres connection string (psycopg format, no +psycopg suffix).
# e.g. postgresql://user:pass@ep-xxx.neon.tech/lunarsync?sslmode=require
DATABASE_URL=
# Cloudinary credentials (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=lunarsync-refs

# --- Hugging Face archive (only needed when REFERENCE_BACKEND=hf) ---
# Token with read access to HF_DATASET. Never commit .env.
HF_TOKEN=
HF_DATASET=lunar-team-2026/data-image
# Optional: cap sweep size (0 = all 626) and early-stop score
HF_SWEEP_LIMIT=0
HF_EARLY_STOP=60.0

# --- Storage paths (local dev) ---
DATA_DIR=./data
MODELS_DIR=./backend/models
